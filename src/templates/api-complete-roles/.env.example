# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# IMPORTANT: This is an example file. DO NOT contain real values.
# 1. Copy this file to .env: cp .env.example .env
# 2. Generate secure values for each variable marked with <GENERATE>
# 3. NEVER commit .env files to the repository
# ==============================================================================

# App
NODE_ENV=development
APP_NAME=ls-template
PORT=3000

# API Keys - SECURITY CRITICAL: Generate with: openssl rand -hex 32
API_KEY=<GENERATE_WITH_openssl_rand_-hex_32>
API_SECRET=<GENERATE_WITH_openssl_rand_-hex_64>

# JWT Secrets - SECURITY CRITICAL: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<GENERATE_64_CHARACTER_HEX>
JWT_EXPIRES_IN=15m                     # RECOMMENDED: 15-30 minutes (not 1 day)

# Database
# Supported types: postgres, mysql, mariadb, sqlite, mssql, oracle, cockroachdb, etc.
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-password-here
DB_NAME=your_database_name
DB_SSL=false

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
JWT_REFRESH_SECRET=<GENERATE_64_CHARACTER_HEX>
JWT_REFRESH_EXPIRES_IN=7d

# Security - Password Hashing
BCRYPT_SALT_ROUNDS=12              # Minimum 12 for 2025+ (12-14 recommended)

# Security - HTTP Headers
HSTS_MAX_AGE=31536000              # HSTS max age in seconds (31536000 = 1 year)

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                    # Optional - leave empty if no password
REDIS_DB=0                         # Database number (0-15)

# Performance - Cache
CACHE_TTL=300                      # Medium/default TTL (seconds)
CACHE_TTL_SHORT=60                 # Short TTL (seconds) - frequently changing data
CACHE_TTL_LONG=3600                # Long TTL (seconds) - rarely changing data
CACHE_TTL_EXTRA_LONG=86400         # Extra long TTL (seconds) - static data
CACHE_MAX_ITEMS=1000               # Maximum number of items in cache
CLUSTER_WORKERS=auto               # Number of cluster workers (auto = CPU cores)

# Cache TTL Specific (in milliseconds)
PERMISSIONS_CACHE_TTL=300000       # TTL for user permissions cache (5 minutes)

# Database Pool Configuration
DB_POOL_SIZE=10                    # Maximum connections in pool (Recommendation: CPU cores * 2 + disks)
DB_IDLE_TIMEOUT=30000              # Time (ms) before closing idle connection
DB_CONNECTION_TIMEOUT=10000        # Maximum time (ms) to get connection from pool

# Rate Limiting - Global
THROTTLE_TTL=60000                  # Window time (ms) - 60 seconds
THROTTLE_LIMIT=100                  # Global request limit per window

# Rate Limiting - Specific Endpoints
THROTTLE_LOGIN_LIMIT=5              # Login: 5 attempts per minute (anti-brute force)
THROTTLE_FORGOT_PASSWORD_LIMIT=3    # Password recovery: 3 attempts per minute
THROTTLE_REGISTER_LIMIT=10          # Registration: 10 attempts per minute

# Super Admin User (For initial seeder)
# IMPORTANT: Change immediately after installation
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=<GENERATE_STRONG_PASSWORD>  # Min 8 chars: uppercase, lowercase, number, special
SUPER_ADMIN_FIRST_NAME=Admin
SUPER_ADMIN_LAST_NAME=User

# Swagger
SWAGGER_TITLE=Your API Title
SWAGGER_DESCRIPTION=Your API Description
SWAGGER_VERSION=1.0.0

# Email Configuration (SMTP) - Optional
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASS=<YOUR_APP_PASSWORD>    # Use Gmail App Password, NOT real password
EMAIL_FROM_NAME=App
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_APP_NAME=App
EMAIL_SUPPORT_EMAIL=support@yourdomain.com
FRONTEND_URL=http://localhost:3001

# ==============================================================================
# COMMANDS TO GENERATE SECURE SECRETS
# ==============================================================================
# JWT Secret (64 chars hex): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API Key (32 bytes): openssl rand -hex 32
# Password (base64): openssl rand -base64 32
# ==============================================================================

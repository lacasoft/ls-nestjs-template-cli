# App
NODE_ENV=development
APP_NAME=your-app-name
APP_URL=http://localhost:3000
PORT=3000
API_KEY=your-api-key-here
API_SECRET=your-api-secret-here
JWT_SECRET=your-jwt-secret-key-min-32-chars-required
JWT_EXPIRES_IN=1d

# Default User Settings
DEFAULT_TIMEZONE=America/Mexico_City
DEFAULT_CURRENCY=MXN
DEFAULT_LANGUAGE=es

# Database
# Supported types: postgres, mysql, mariadb, sqlite, mssql, oracle, cockroachdb, etc.
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-password-here
DB_NAME=your_database_name
DB_SSL=false

# Seguridad
ALLOWED_ORIGINS=http://localhost:3000,https://tudominio.com
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-required
JWT_REFRESH_EXPIRES_IN=7d

# Performance
CACHE_TTL=300
CACHE_MAX_ITEMS=100
CLUSTER_WORKERS=auto

# Database Pool
DB_POOL_SIZE=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Admin User (Para seeder inicial)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecurePassword123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Swagger
SWAGGER_TITLE=Your API Title
SWAGGER_DESCRIPTION=Your API Description
SWAGGER_VERSION=1.0.0

# Stripe Payment Integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=usd

# PayPal Payment Integration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox  # or 'production' for live transactions
PAYPAL_WEBHOOK_ID=your_webhook_id

# Bank Transfer / Depósito Bancario
BANK_NAME=Nombre del Banco
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_HOLDER=Nombre del Beneficiario
BANK_ACCOUNT_TYPE=Checking
BANK_ROUTING_NUMBER=000000000
BANK_SWIFT_CODE=XXXXXX
WHATSAPP_NUMBER=+525512345678
WHATSAPP_MESSAGE=Al realizar el pago, envía tu comprobante a este WhatsApp

# Email Configuration (SMTP)
# Para Gmail: Requiere App Password (no tu contraseña normal)
# 1. Habilita 2FA en tu cuenta Google
# 2. Ve a https://myaccount.google.com/apppasswords
# 3. Genera un App Password y úsalo abajo (16 caracteres SIN espacios)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=abcdefghijklmnop  # App Password de 16 caracteres (sin espacios)
SMTP_FROM_NAME=Your App Name
SMTP_FROM_EMAIL=noreply@yourapp.com
FRONTEND_URL=http://localhost:3001

# Admin User (usado para notificaciones de admin)
ADMIN_EMAIL=admin@example.com

# Cron Jobs Schedule (Cron expression format)
CRON_CHECK_EXPIRING_TRIALS=0 0 * * *
CRON_PROCESS_RENEWALS=0 1 * * *
CRON_ACTIVATE_SCHEDULED_PERIODS=0 2 * * *
CRON_CLEANUP_EXPIRED_INVITATIONS=0 3 * * *
CRON_REMIND_PENDING_APPROVALS=0 10 * * *
CRON_RETRY_FAILED_PAYMENTS=0 */6 * * *
